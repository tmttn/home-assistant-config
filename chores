#!/bin/bash

#    ____ _
#   / ___| |__   ___  _ __ ___  ___
#  | |   | '_ \ / _ \| '__/ _ \/ __|
#  | |___| | | | (_) | | |  __/\__ \
#   \____|_| |_|\___/|_|  \___||___/
#
#- from github.com/tmttn/home-assistant-config

LOGFILE="/config/chores.log"
MAX_LOG_LINES=500

# Rotate log if it exceeds MAX_LOG_LINES
if [[ -f "$LOGFILE" ]] && [[ $(wc -l < "$LOGFILE") -gt $MAX_LOG_LINES ]]; then
    tail -n $MAX_LOG_LINES "$LOGFILE" > "${LOGFILE}.tmp"
    mv "${LOGFILE}.tmp" "$LOGFILE"
fi

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
}

# Send notification to Home Assistant
ha_notify() {
    local title="$1"
    local message="$2"
    local HA_URL="http://supervisor/core"

    # Use Supervisor token if available (HA OS/Supervised), otherwise try local token
    if [[ -n "$SUPERVISOR_TOKEN" ]]; then
        local TOKEN="$SUPERVISOR_TOKEN"
    elif [[ -f /config/.ha-token ]]; then
        local TOKEN=$(cat /config/.ha-token | tr -d '[:space:]')
        HA_URL="http://localhost:8123"
    else
        log "No HA token available for notifications"
        return 1
    fi

    # Persistent notification (shows in HA sidebar)
    curl -sf -X POST \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -d "{\"title\": \"$title\", \"message\": \"$message\", \"notification_id\": \"chores_git_error\"}" \
        "$HA_URL/api/services/persistent_notification/create" >> "$LOGFILE" 2>&1 || true

    # Mobile notification, only when the alert changes: chores runs every
    # 15 minutes, so a stuck repo would otherwise ping the phone all day.
    if [[ "$(cat "$ALERT_STAMP" 2>/dev/null)" != "$title|$message" ]]; then
        echo "$title|$message" > "$ALERT_STAMP"
        curl -sf -X POST \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "{\"title\": \"$title\", \"message\": \"$message\"}" \
            "$HA_URL/api/services/notify/tom" >> "$LOGFILE" 2>&1 || true
    fi
}

ALERT_STAMP="/config/.chores-last-alert"
BRANCH="main"

# Redirect all stderr to log file as well
exec 2>> "$LOGFILE"

log "===== Starting chores script ====="
log "Working directory: $(pwd)"
log "Git status:"
git status >> "$LOGFILE" 2>&1 || log "git status failed"

set -e  # Exit immediately on error

log "Setting git config..."
git config --global user.name "Thomas Metten"
git config --global user.email "thomas.metten@gmail.com"

# Plain public HTTPS origin. The Git pull app refuses to sync unless origin
# matches its `repository` option exactly, and a public repo needs no
# credentials to pull.
ORIGIN_URL="https://github.com/tmttn/home-assistant-config.git"

log "Setting up HTTPS authentication..."
if [[ -f /config/.git-token ]]; then
    GIT_TOKEN=$(cat /config/.git-token | tr -d '[:space:]')
    git remote set-url origin "https://${GIT_TOKEN}@github.com/tmttn/home-assistant-config.git"
else
    log "ERROR: /config/.git-token not found"
    exit 1
fi

# Restore the plain origin on exit: drops the token from .git/config and
# keeps the Git pull app's origin check passing
trap 'git remote set-url origin "$ORIGIN_URL"' EXIT

# Refuse to run on a half-finished git operation. Without this, a leftover
# conflict makes every later run die at `git stash` ("needs merge") before
# any notification is sent, so the repo silently stops syncing.
GIT_DIR=$(git rev-parse --git-dir)
if [[ -n "$(git ls-files --unmerged)" ]] || [[ -d "$GIT_DIR/rebase-merge" ]] \
    || [[ -d "$GIT_DIR/rebase-apply" ]] || [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
    log "ERROR: unfinished merge/rebase or unresolved conflicts. Skipping."
    ha_notify "⚠️ Git stuck" "Config repo has an unfinished merge/rebase. Resolve it on the HA box; check /config/chores.log"
    exit 1
fi

CURRENT_BRANCH=$(git branch --show-current)
if [[ "$CURRENT_BRANCH" != "$BRANCH" ]]; then
    log "ERROR: on branch '$CURRENT_BRANCH', expected '$BRANCH'. Skipping."
    ha_notify "⚠️ Git wrong branch" "Config repo is on '$CURRENT_BRANCH' instead of '$BRANCH'. Check /config/chores.log"
    exit 1
fi

# Don't pull if incoming changes touch files that are modified locally: the
# stash pop afterwards would leave conflict markers in live config files.
log "Fetching origin/$BRANCH..."
git fetch origin "$BRANCH" >> "$LOGFILE" 2>&1
OVERLAP=$(comm -12 \
    <(git diff --name-only HEAD..."origin/$BRANCH" | sort -u) \
    <({ git diff --name-only; git diff --cached --name-only; } | sort -u))
if [[ -n "$OVERLAP" ]]; then
    log "ERROR: incoming changes overlap uncommitted local edits: $OVERLAP"
    ha_notify "⚠️ Git Conflict" "Incoming changes touch locally modified files ($(echo $OVERLAP)). Commit or revert them on the HA box."
    exit 1
fi

# Stash any uncommitted changes before pulling
STASHED=false
if ! git diff --quiet || ! git diff --cached --quiet; then
    log "Stashing uncommitted changes..."
    git stash push -m "chores-auto-stash" >> "$LOGFILE" 2>&1
    STASHED=true
fi

log "Pulling latest changes..."
if ! git pull --rebase origin "$BRANCH" >> "$LOGFILE" 2>&1; then
    log "ERROR: Pull failed, likely due to conflicts"
    log "Aborting rebase to restore clean state..."
    git rebase --abort >> "$LOGFILE" 2>&1 || true
    if $STASHED; then
        log "Restoring stashed changes..."
        git stash pop >> "$LOGFILE" 2>&1 || true
    fi
    log "Please resolve conflicts manually. Skipping push."
    ha_notify "⚠️ Git Conflict" "Config repo has conflicts that need manual resolution. Check /config/chores.log"
    exit 1
fi

# Restore stashed changes
if $STASHED; then
    log "Restoring stashed changes..."
    if ! git stash pop >> "$LOGFILE" 2>&1; then
        log "ERROR: Stash pop had conflicts. Stopping before committing or pushing."
        ha_notify "⚠️ Git Conflict" "Restoring local changes after pull conflicted. Resolve on the HA box; check /config/chores.log"
        exit 1
    fi
fi

log "Running commit-updates.py..."
python3 utils/commit-updates.py

log "Installing pip packages..."
pip3 -q install --root-user-action=ignore pyfiglet jinja2

log "Running ascii_art.py..."
python3 utils/ascii_art.py

log "Running update-readme.py..."
python3 utils/update-readme.py

log "Running commit-readme.sh..."
./utils/commit-readme.sh

# Single push at the end, so the README/ascii-art commits go out too
# (this replaces the old post-commit hook that pushed master).
log "Pushing to origin/$BRANCH..."
git push origin "$BRANCH" >> "$LOGFILE" 2>&1

rm -f "$ALERT_STAMP"
log "Chores completed successfully"